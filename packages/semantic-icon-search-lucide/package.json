{
  "name": "semantic-icon-search-lucide",
  "version": "0.1.0",
  "description": "Suggest Lucide icons for a name by meaning, in the browser, with no model at runtime",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./index.json": "./data/index.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "data"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node --test"
  },
  "dependencies": {
    "semantic-icon-search": "^0.1.0"
  },
  "keywords": [
    "lucide",
    "icons",
    "semantic search",
    "icon search",
    "icon suggestion",
    "embeddings",
    "offline"
  ],
  "license": "MIT",
  "author": "Mike Anderson",
  "homepage": "https://github.com/mike-anderson/semantic-icon-search#readme",
  "bugs": "https://github.com/mike-anderson/semantic-icon-search/issues",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mike-anderson/semantic-icon-search.git",
    "directory": "packages/semantic-icon-search-lucide"
  }
}
